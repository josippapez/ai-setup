{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-stop.cjs\"",
            "timeout": 60,
            "statusMessage": "Checking claims against what actually ran"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-stop.cjs\"",
            "timeout": 30,
            "statusMessage": "Checking subagent claims"
          }
        ]
      }
    ]
  }
}
