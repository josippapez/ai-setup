{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "diff -q \"${CLAUDE_PLUGIN_ROOT}/package.json\" \"${CLAUDE_PLUGIN_DATA}/package.json\" >/dev/null 2>&1 || (cd \"${CLAUDE_PLUGIN_DATA}\" && cp \"${CLAUDE_PLUGIN_ROOT}/package.json\" . && npm install --no-fund --no-audit) || rm -f \"${CLAUDE_PLUGIN_DATA}/package.json\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 2"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 3"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 0 SubagentStart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 1 SubagentStart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 2 SubagentStart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.cjs\" 3 SubagentStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules-digest.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" writing-code"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" searching '' '((-g|--glob|--iglob|--include|--type|-t)[=\\s]+[\\\"\\x27]?\\*?\\.?(md|markdown|json|ya?ml|toml|txt)\\b|-name\\s+[\\\"\\x27]?\\*\\.(md|markdown|json|ya?ml|toml|txt)\\b|\\.(md|markdown|json|ya?ml|toml|txt)[\\\"\\x27]?(\\s|$))'"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" reading-libraries '(^|[^\\w.-])(node_modules|\\.opensrc)/' '(-not\\s+-path|!\\s+-path|--exclude-dir|--exclude=|--ignore-dir|-prune|(-g|--glob|--iglob)\\s*.{0,2}!)'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" writing-code '(^|[\\s;&|])(sed\\s+-i|tee)\\b|>>?\\s*(?!/dev/|/tmp/)[^\\s&|>]+\\.[A-Za-z0-9]{1,6}(\\s|$)'"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" searching '(^|[\\s;&|])(grep|rg|ag|find|codegraph)\\b' '((-g|--glob|--iglob|--include|--type|-t)[=\\s]+[\\\"\\x27]?\\*?\\.?(md|markdown|json|ya?ml|toml|txt)\\b|-name\\s+[\\\"\\x27]?\\*\\.(md|markdown|json|ya?ml|toml|txt)\\b|\\.(md|markdown|json|ya?ml|toml|txt)[\\\"\\x27]?(\\s|$))'"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" reading-libraries '(^|[^\\w.-])(node_modules|\\.opensrc)/' '(-not\\s+-path|!\\s+-path|--exclude-dir|--exclude=|--ignore-dir|-prune|(-g|--glob|--iglob)\\s*.{0,2}!)'"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule-card.cjs\" git-commit '(^|[\\s;&|])git\\s+commit\\b'"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/git-mv-guard.cjs\""
          }
        ]
      }
    ]
  }
}
