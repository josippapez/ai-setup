{
  "interactive": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@rawwee/interactive-mcp",
      "-t",
      "1200",
      "--disable-tools",
      "message_complete_notification"
    ],
    "timeout": 1210000
  },
  "context7": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp"
    ]
  },
  "chrome-devtools": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--autoConnect"
    ]
  }
}
