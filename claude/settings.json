{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "autoContinueAtUsageLimit": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(rtk read *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(rtk rg *)",
      "Bash(rtk find *)",
      "Bash(rtk diff *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)",
      "Bash(rtk git branch *)",
      "Bash(rtk git ls-files *)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git check-ignore *)",
      "Bash(rtk hook check *)",
      "Bash(rtk gain *)",
      "Bash(rtk npx opensrc path *)",
      "Bash(npx opensrc path *)",
      "mcp__plugin_repo-docs_repo-docs__find_docs",
      "mcp__plugin_repo-docs_repo-docs__read_doc",
      "mcp__plugin_repo-docs_repo-docs__list_docs",
      "mcp__plugin_repo-docs_repo-docs__find_libs",
      "mcp__plugin_repo-docs_codegraph__codegraph_explore",
      "mcp__Framelink_Figma__get_figma_data",
      "mcp__figma__get_design_context",
      "mcp__figma__get_variable_defs",
      "mcp__figma__get_metadata",
      "mcp__figma__get_screenshot",
      "mcp__plugin_dev-core_chrome-devtools__list_pages",
      "mcp__plugin_dev-core_chrome-devtools__take_screenshot",
      "mcp__plugin_dev-core_chrome-devtools__take_snapshot",
      "mcp__plugin_dev-core_chrome-devtools__list_console_messages",
      "mcp__plugin_dev-core_chrome-devtools__list_network_requests"
    ]
  },
  "model": "opus[1m]",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CODEGRAPH_TELEMETRY": "0"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size </dev/tty 2>/dev/null | awk '\"'\"'{print $2}'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/opt/homebrew/bin/bun\" --env-file /dev/null \"${plugin_dir}src/index.ts\"'",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "dev-core@ai-setup": true,
    "concise-output@ai-setup": true,
    "orchestrate@ai-setup": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "orchestrate-nightly@ai-setup": true
  },
  "extraKnownMarketplaces": {
    "ai-setup": {
      "source": {
        "source": "directory",
        "path": "/Users/josippapez/Desktop/ai-setup/claude"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "effortLevel": "medium",
  "skillListingBudgetFraction": 0.05,
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_RUN_ESLINT=1 node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/scripts/format-lint-edited-files.mjs\"",
            "timeout": 120,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
