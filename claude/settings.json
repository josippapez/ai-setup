{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "autoContinueAtUsageLimit": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(rtk read *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(rtk rg *)",
      "Bash(rtk find *)",
      "Bash(rtk diff *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)",
      "Bash(rtk git branch *)",
      "Bash(rtk git ls-files *)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git check-ignore *)",
      "Bash(rtk hook check *)",
      "Bash(rtk gain *)",
      "Bash(rtk npx opensrc path *)",
      "Bash(npx opensrc path *)",
      "mcp__plugin_repo-docs_repo-docs__find_docs",
      "mcp__plugin_repo-docs_repo-docs__read_doc",
      "mcp__plugin_repo-docs_repo-docs__list_docs",
      "mcp__plugin_repo-docs_repo-docs__find_libs",
      "mcp__plugin_repo-docs_repo-docs__get_file_dependents",
      "mcp__plugin_repo-docs_repo-docs__get_blast_radius",
      "mcp__Framelink_Figma__get_figma_data",
      "mcp__figma__get_design_context",
      "mcp__figma__get_variable_defs",
      "mcp__figma__get_metadata",
      "mcp__figma__get_screenshot",
      "mcp__plugin_dev-core_chrome-devtools__list_pages",
      "mcp__plugin_dev-core_chrome-devtools__take_screenshot",
      "mcp__plugin_dev-core_chrome-devtools__take_snapshot",
      "mcp__plugin_dev-core_chrome-devtools__list_console_messages",
      "mcp__plugin_dev-core_chrome-devtools__list_network_requests",
      "mcp__plugin_dev-core_browse__status",
      "mcp__plugin_dev-core_browse__snapshot",
      "mcp__plugin_dev-core_browse__screenshot",
      "mcp__plugin_dev-core_browse__console",
      "mcp__plugin_dev-core_browse__network",
      "mcp__plugin_feedback_feedback__collect_feedback",
      "mcp__plugin_feedback_feedback__read_feedback",
      "mcp__plugin_feedback_feedback__update_feedback",
      "mcp__wings__tasks__*",
      "mcp__wings__search_history",
      "mcp__wings__list_sessions",
      "mcp__wings__project_info_read",
      "mcp__wings__read_session",
      "mcp__wings__read_pane",
      "mcp__wings__changes__changed_files",
      "mcp__wings__changes__recent_commits",
      "mcp__wings__pr-tracker__pull_request",
      "mcp__wings__pr-tracker__failing_checks",
      "mcp__wings__disk__list_disks",
      "mcp__wings__disk__folder_usage",
      "mcp__wings__disk__largest_files",
      "mcp__wings__schedules__list",
      "mcp__wings__sprint-board__board_check",
      "mcp__wings__cyclops__list_projects",
      "mcp__wings__cyclops__list_entries",
      "mcp__wings__cyclops__running_timers",
      "mcp__wings__performance"
    ]
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/bun --env-file /dev/null \"$HOME/.claude/plugins/claude-hud/statusline.mjs\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "repo-docs@ai-setup": true,
    "dev-core@ai-setup": true,
    "concise-output@ai-setup": true,
    "rules-index@ai-setup": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "better-design@ai-setup": true,
    "fundamentals@ai-setup": true,
    "verified@ai-setup": false,
    "feedback@ai-setup": true,
    "scope@ai-setup": true,
    "journal@ai-setup": true,
    "teach-back@ai-setup": true
  },
  "extraKnownMarketplaces": {
    "ai-setup": {
      "source": {
        "source": "directory",
        "path": "/Users/josippapez/Desktop/ai-setup"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "effortLevel": "high",
  "skillListingBudgetFraction": 0.05,
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_RUN_ESLINT=1 node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/scripts/format-lint-edited-files.mjs\"",
            "timeout": 120,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  }
}
