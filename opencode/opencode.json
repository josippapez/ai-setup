{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    ".github/instructions/*.instructions.md",
    "rules/*.md",
    "rules/*.instruction.md"
  ],
  "plugin": [
    "./plugins/rtk.ts",
    "./plugins/format-lint-edited-files.js",
    "./plugins/prompt-loop-reminder.js",
    "./plugins/git-move-guard.js",
    ["./plugins/interactive-mcp/interactive-mcp.js", { "injectDebug": true }]
  ],
  "skills": {
    "paths": ["./skills"]
  },
  "subagent_depth": 2,
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "glob": "allow",
    "grep": "allow"
  },
  "compaction": {
    "prune": true,
    "auto": true,
    "reserved": 8192
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "mcp": {
    "Context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "timeout": 120000
    },
    "Framelink Figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "timeout": 120000
    },
    "storybook-web-components": {
      "type": "remote",
      "url": "http://localhost:6006/mcp"
    }
  }
}
