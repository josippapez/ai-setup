{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    ".github/instructions/*.instructions.md",
    "rules/*.md",
    "rules/*.instruction.md",
    "rules/concise-output/*.md"
  ],
  "plugin": [
    "./plugins/rtk.ts",
    "./plugins/format-lint-edited-files.js",
    "./plugins/git-move-guard.js",
    "./plugins/dev-core/dev-core.js"
  ],
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "subagent_depth": 2,
  "permission": {
    "question": "allow",
    "websearch": "allow",
    "glob": "allow",
    "grep": "allow"
  },
  "compaction": {
    "prune": true,
    "auto": true,
    "reserved": 8192
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "mcp": {
    "Context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "timeout": 120000
    },
    "Framelink Figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "timeout": 120000
    },
    "interactive": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@rawwee/interactive-mcp",
        "-t",
        "1200",
        "--disable-tools",
        "message_complete_notification"
      ],
      "timeout": 1210000
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    }
  }
}
