{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": [
    "./plugins/rtk",
    "./plugins/format-lint-edited-files",
    "./plugins/git-move-guard",
    "./plugins/dev-core"
  ],
  "skills": ["./skills"],
  "permissions": [
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "buffer": 8192
  },
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "servers": {
      "Context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
      },
      "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "timeout": { "catalog": 120000, "execution": 120000 }
      },
      "computer-use": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "computer-use-mcp"
      ]
      },
      "Framelink Figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "timeout": { "catalog": 120000, "execution": 120000 }
      },
      "interactive": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@rawwee/interactive-mcp",
        "-t",
        "1200",
        "--disable-tools",
        "message_complete_notification"
      ],
      "timeout": { "catalog": 1210000, "execution": 1210000 }
      }
    }
  }
}
